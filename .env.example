# =============================================================================
# NTL-SysToolbox - Variables d'environnement (Secrets)
# ATTENTION: Ne jamais commiter ce fichier dans Git !
# =============================================================================

# Credentials Base de données WMS
NTL_DB_USER=wms_admin
NTL_DB_PASSWORD=changeme_secure_password

# Credentials Active Directory (pour requêtes LDAP)
NTL_AD_USER=administrator@nordtransit.local
NTL_AD_PASSWORD=changeme_ad_password

# Clé de chiffrement pour les sauvegardes (optionnel)
NTL_BACKUP_ENCRYPTION_KEY=

# Configuration SMTP pour alertes (optionnel)
NTL_SMTP_HOST=
NTL_SMTP_PORT=587
NTL_SMTP_USER=
NTL_SMTP_PASSWORD=
NTL_ALERT_EMAIL=admin@nordtransit.local
